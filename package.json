{
  "name": "cvc-website",
  "private": true,
  "description": "The official website for the Computational Visualization Center (CVC) at UT Austin",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.14.0 <26"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "babel-jest": "^30.1.2",
    "babel-preset-gatsby": "^3.16.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "express": "^4.21.2",
    "gh-pages": "^6.1.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "0BSD",
  "scripts": {
    "develop": "gatsby develop",
    "start": "gatsby develop",
    "build": "GATSBY_CPU_COUNT=1 gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "deploy": "gatsby clean && GATSBY_CPU_COUNT=1 gatsby build && gh-pages -d public --nojekyll",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,css}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:companion": "python3 -B scripts/test_pd_companion_data.py",
    "test:companion:browser": "python3 scripts/test_pd_companion_browser.py",
    "type-check": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CVC-Lab/cvc-lab.github.io"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "bugs": {
    "url": "https://github.com/CVC-Lab/cvc-lab.github.io/issues"
  },
  "author": "CVC Team <cvc@utexas.edu>",
  "homepage": "https://cvc-lab.github.io/",
  "dependencies": {
    "@fontsource/libre-franklin": "^5.2.6",
    "dotenv": "^17.2.2",
    "gatsby": "^5.16.1",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.15.0",
    "gatsby-remark-copy-linked-files": "^6.16.0",
    "gatsby-remark-embed-video": "^3.2.1",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-katex": "^7.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "isomorphic-dompurify": "2.25.0",
    "js-yaml": "4.3.2",
    "katex": "0.16.28",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0"
  },
  "overrides": {
    "katex": "$katex",
    "path-to-regexp": "0.1.13",
    "cookie": "^0.7.0",
    "engine.io": {
      "cookie": "^0.7.0"
    },
    "tmp": "^0.2.6",
    "qs": "^6.16.0"
  }
}
